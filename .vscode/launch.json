{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo sweep",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/demos/demo_sweep.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Demo CLI: wifi-tx ch6",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/demos/demo.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--ip", "192.168.141.60",
        "--dut-service", "192.168.141.60:50051",
        "--dut-port", "COM8",
        "--tx-port", "1",
        "-v",
        "wifi-tx",
        "--channel", "6",
        "--rate", "G_6M",
        "--wlan-standard", "A_G",
        "--wlan-bw", "BW20"
      ]
    },
    {
      "name": "Demo CLI: ble-tx ch21",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/demos/demo.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--ip", "192.168.141.60",
        "--dut-service", "192.168.141.60:50051",
        "--dut-port", "COM8",
        "--tx-port", "1",
        "-v",
        "ble-tx",
        "--channel", "21",
        "--power-level", "15"
      ]
    },
    {
      "name": "Demo CLI: wifi-external AX 80M",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/demos/demo.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--ip", "192.168.141.60",
        "--tx-port", "2",
        "-v",
        "wifi-external",
        "--frequency-hz", "5.21e9",
        "--wlan-standard", "AX",
        "--wlan-bw", "BW80",
        "--ref-level", "-10",
        "--sem"
      ]
    }
  ]
}