{
  "name": "UWT Python SCPI",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "postCreateCommand": "pip install -e \"python/[demo,dev]\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}